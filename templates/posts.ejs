```{=html}
<% if (items.length === 0) { %>
<p class="blog-empty"><%- templateParams.empty %></p>
<% } %>
<ul class="entries<% if (items.length) { %> list<% } %>">
<% for (const item of items) { %>
<li class="entry" <%= metadataAttrs(item) %>>
  <div class="when listing-date"><%- item.date || "" %></div>
  <div>
    <h3 class="entry-title"><a class="listing-title" href="<%- item.path %>"><%= item.title %></a></h3>
    <% if (item.description) { %><p class="entry-desc listing-description"><%= item.description %></p><% } %>
    <% if (item.categories && item.categories.length) { %>
    <ul class="post-topics listing-categories" aria-label="Post topics">
      <% for (const category of item.categories) { %>
      <li><button class="listing-category" type="button" data-topic="<%- category %>"><%- category %></button></li>
      <% } %>
    </ul>
    <% } %>
    <svg class="spark" data-spark="<%- item.path %>" aria-hidden="true"></svg>
  </div>
</li>
<% } %>
</ul>
```
